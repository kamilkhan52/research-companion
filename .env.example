# Copy to .env and fill in. You can also set the key from the web UI Settings.
OPENROUTER_API_KEY=

# Default model (any OpenRouter model id). Switchable from the UI.
RC_MODEL=anthropic/claude-opus-4.6

# Server bind. 0.0.0.0 so the cloudflare tunnel / phone can reach it.
RC_HOST=0.0.0.0
RC_PORT=8000

# Optional Obsidian vault. When set, prompts live in <vault>/Prompts and the actual project
# repositories live in <vault>/Projects. Explicit RC_PROMPTS_DIR / RC_PROJECTS_ROOT values win.
RC_VAULT_ROOT=
RC_PROMPTS_DIR=
RC_PROJECTS_ROOT=

# Optional: shown to OpenRouter for ranking; harmless to leave as-is.
RC_APP_TITLE=Research Reading Companion

# Author for the commits the app makes into each project's git store (note approvals, etc.).
# The app pins this explicitly, so it works on a fresh server/container with no `git config
# --global`. Defaults below; override to attribute the record to a specific identity.
RC_GIT_AUTHOR_NAME=Research Companion
RC_GIT_AUTHOR_EMAIL=companion@local

# ---- Environment ----
# dev | staging | prod. REQUIRED — there is no default. Unset refuses to start, and so does any
# other value (a typo like "production" must never silently disable production hardening).
# run.sh falls back to dev for local runs and the Dockerfile bakes prod into the image, so the
# only way to get an unset RC_ENV is to bypass both — which is exactly when failing closed matters.
# In staging/prod the process REFUSES TO BOOT unless: auth is Supabase, RC_AUTH_TOKEN is unset,
# RC_DEV is off, and RC_ALLOWED_USERS lists at least one user. Every one of those guards an
# *omission* — forgetting a variable would otherwise produce the most permissive instance.
RC_ENV=dev

# Comma-separated Supabase user ids allowed to use this instance. Empty = anyone who authenticates
# (dev only). Required in staging/prod because Supabase sign-up is self-service: without it, the
# first stranger to register gets every project and the shared provider keys. Remove this
# requirement only once per-user ownership (M2) is enforced.
RC_ALLOWED_USERS=

# ---- Auth (optional; leave blank for open local use) ----
# Supabase Auth (Google + email): set both to require user login. See README "Auth setup".
# The anon key is publishable (safe in clients). Leave blank => no auth (open).
RC_SUPABASE_URL=
RC_SUPABASE_ANON_KEY=
# Legacy alternative to Supabase: a single shared secret gate (Bearer or ?token=).
# Ignored when RC_SUPABASE_URL is set.
RC_AUTH_TOKEN=

# Browser cross-origin (only needed for a web client on a different origin; native apps ignore).
RC_CORS_ORIGINS=
