.venv/
.venv
__pycache__/
*.pyc
.env
# Reading data stores are their own git repos (notes, corpus, sessions) — keep them out of
# the code repo. `project/` is the pre-multiproject store; `projects/` holds per-project repos.
project/
projects/
projects.bak-*
projects-backup-*
# App-global state: keys/settings, legacy prompt overrides, last-valid prompt state, caches.
.app-state/
*.log

# Web client (Vite)
web/node_modules/

# In-app device-test feedback inbox (DR-060) — triaged into the ledger by /device-feedback
.dev-feedback/
